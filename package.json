{
  "name": "pion",
  "version": "0.1.0",
  "description": "pi extension that runs the agent's tools inside a per-project sandbox (LXD VMs or Canonical Workshop)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "test:lxd": "PION_LXD_TEST=1 vitest --run test/lxd.integration.test.ts",
    "test:workshop": "PION_WORKSHOP_TEST=1 vitest --run test/workshop.integration.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
